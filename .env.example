# ==============================================================================
# HydroViz Configuration & Environment Template
# Track B: Himalayan Rapid Flood Impact & Isolation System
# ==============================================================================

# Copernicus Data Space Ecosystem (CDSE) Credentials
# Required only for LIVE satellite raster ingestion of arbitrary custom AOIs.
# Leave as placeholder to use offline curated reference benchmarks (e.g. Melamchi EMSR927).
CDSE_CLIENT_ID=your_client_id_here
CDSE_CLIENT_SECRET=your_client_secret_here

# Database & In-Memory Store (optional in standalone local testing)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hydroviz
POSTGRES_USER=hydroviz
POSTGRES_PASSWORD=your_postgres_password_here
REDIS_URL=redis://redis:6379

# Storage & Model Paths
DATA_DIR=./data
MODEL_PATH=./flood_seg_v1_int8.onnx
DEM_PATH=./data/dem/copernicus_30m.tif

# Processing Constraints
MAX_AOI_AREA_KM2=2500
S2_CLOUD_THRESHOLD=0.7
