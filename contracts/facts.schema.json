{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "HydroViz Facts",
    "type": "object",
    "required": ["job_id", "aoi", "event_date", "generated_at", "inputs", "flood", "exposure", "cutoff"],
    "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "aoi": {
            "type": "object",
            "required": ["bbox", "area_km2"],
            "properties": {
                "bbox": {
                    "type": "array",
                    "items": { "type": "number" },
                    "minItems": 4,
                    "maxItems": 4
                },
                "area_km2": { "type": "number" }
            }
        },
        "event_date": { "type": "string", "format": "date" },
        "generated_at": { "type": "string", "format": "date-time" },
        "inputs": {
            "type": "object",
            "properties": {
                "s1_pre": { "type": "array", "items": { "type": "object" } },
                "s1_post": { "type": "object" },
                "s2_post": { "type": ["object", "null"] },
                "osm_snapshot": { "type": "string", "format": "date" },
                "dem": { "type": "string" },
                "model": { "type": "object" }
            }
        },
        "flood": {
            "type": "object",
            "properties": {
                "flooded_area_km2": { "type": "number" },
                "debris_area_km2": { "type": "number" },
                "mean_confidence": { "type": "number" },
                "mode": { "type": "string", "enum": ["sar_only", "sar_s2"] }
            }
        },
        "exposure": {
            "type": "object",
            "properties": {
                "buildings": {
                    "type": "object",
                    "properties": {
                        "total": { "type": "integer" },
                        "exposed_high": { "type": "integer" },
                        "exposed_medium": { "type": "integer" }
                    }
                },
                "roads_km": {
                    "type": "object",
                    "properties": {
                        "total": { "type": "number" },
                        "exposed": { "type": "number" }
                    }
                },
                "bridges": { "type": "array", "items": { "type": "object" } }
            }
        },
        "cutoff": {
            "type": "object",
            "properties": {
                "mode": { "type": "string" },
                "scenario": { "type": "string" },
                "settlements": { "type": "array", "items": { "type": "object" } }
            }
        },
        "flood_path": { "type": ["object", "null"] },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "provenance": { "type": "array", "items": { "type": "object" } }
    }
}
